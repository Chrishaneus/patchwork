# Copy to .env and adjust. Read by `docker compose`.

# Repositories are added by URL in the app. Only if you also use compose.local-repos.yaml:
# the folder with local git repositories to share (readable and writable by the agent).
# REPOS_DIR=/home/you/projects

WEB_PORT=8080

# Listen on this machine only. To open the server to your network, set WEB_BIND=0.0.0.0
# and also set PATCHWORK_TOKEN.
WEB_BIND=127.0.0.1
# PATCHWORK_TOKEN=change-me

# "Sign in with GitHub": the client ID of your GitHub App (or set it in Settings).
# PATCHWORK_GITHUB_CLIENT_ID=Iv23li...

# ANTHROPIC_API_KEY=sk-ant-...
# For Codex (OpenAI models):
# OPENAI_API_KEY=sk-...

# Pull requests: a GitHub token (fine-grained: Contents and Pull requests, read and write).
# GITHUB_TOKEN=github_pat_...
# GITLAB_TOKEN=glpat-...

# Author of the commits the app makes.
# GIT_NAME=Your Name
# GIT_EMAIL=you@example.com
