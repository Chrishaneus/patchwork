{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": [
		"src",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
